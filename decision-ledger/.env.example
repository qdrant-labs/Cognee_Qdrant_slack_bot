# ---------------------------------------------------------------------------
# LLM — used only for entity/relationship extraction during cognify.
# Option A (official demo config): Anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Option B: any OpenAI-compatible endpoint (Alibaba DashScope / Qwen, etc.)
# Comment out Option A above and uncomment these. The model must support
# structured output / function calling — cognify extracts a typed JSON graph.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=custom
# LLM_MODEL=openai/qwen-plus
# LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings — local, no API key, no network. 384-dim BGE small.
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ---------------------------------------------------------------------------
# Vector store: Qdrant.
# Local:  docker run -p 6333:6333 qdrant/qdrant   -> VECTOR_DB_URL=http://localhost:6333
# Cloud:  https://cloud.qdrant.io free tier       -> paste the cluster URL (keep the :6333)
# ---------------------------------------------------------------------------
VECTOR_DB_PROVIDER=qdrant
VECTOR_DATASET_DATABASE_HANDLER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_KEY=

# Qdrant's dataset handler doesn't support cognee's per-user multi-tenant mode.
# We scope visibility ourselves, at the NodeSet level — see retrieve.py.
ENABLE_BACKEND_ACCESS_CONTROL=false
